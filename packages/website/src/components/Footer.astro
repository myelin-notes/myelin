---
import { Wordmark } from '@myelin/ui';

const year = 2026;

const columns = [
  {
    heading: 'Product',
    links: [
      { label: 'Workspace', href: '#workspace' },
      { label: 'Sync', href: '#sync' },
      { label: 'Pricing', href: '#pricing' },
    ],
  },
  {
    heading: 'Get it',
    links: [
      { label: 'Download', href: '#download' },
      { label: 'Release notes', href: '#' },
      { label: 'GitHub sync', href: '#sync' },
    ],
  },
];
---

<footer class="mx-auto max-w-6xl px-6 lg:px-10">
  <div class="h-px w-full bg-border-ghost"></div>
  <div class="grid gap-12 py-16 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <Wordmark className="text-[1.35rem]" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-text-muted">
        A native knowledge workspace that keeps every device you own in
        lockstep.
      </p>
    </div>

    {
      columns.map((column) => (
        <nav class="lg:col-span-3" aria-label={column.heading}>
          <p class="kicker text-text-muted">{column.heading}</p>
          <ul class="mt-5 flex flex-col gap-3">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-text-secondary transition-colors hover:text-text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="flex items-center justify-between pb-12">
    <p class="kicker text-text-muted">© {year} Myelin</p>
    <p class="kicker text-text-muted">Mac · Windows · Linux · iPad · Android</p>
  </div>
</footer>
