---
const year = 2026;

const columns = [
  {
    heading: 'Product',
    links: [
      { label: 'Workspace', href: '#workspace' },
      { label: 'Search', href: '#search' },
      { label: 'Local-first', href: '#local' },
    ],
  },
  {
    heading: 'Get it',
    links: [
      { label: 'Download', href: '#download' },
      { label: 'Export schema', href: '/workspace-schema' },
      { label: 'GitHub sync', href: '#sync' },
    ],
  },
];
---

<footer>
  <p>Myelin Notes</p>
  <p>
    A native, local-first canvas where handwriting, type, PDFs, and audio live
    in one note.
  </p>

  {
    columns.map((column) => (
      <nav aria-label={column.heading}>
        <p>{column.heading}</p>
        <ul>
          {column.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))
  }

  <p>© {year} Myelin Notes</p>
  <p>Mac · Windows · Linux · iPad · Android</p>
</footer>
