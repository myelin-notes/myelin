---
import { Wordmark } from '@myelin/ui';

const year = 2026;
---

<footer class="border-t border-border-subtle">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-12 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex flex-col gap-2">
      <Wordmark />
      <p class="text-sm text-text-muted">
        A knowledge workspace that stays in lockstep across every device.
      </p>
    </div>
    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-sm" aria-label="Footer">
      <a href="#features" class="text-text-secondary hover:text-text-primary"
        >Features</a
      >
      <a href="#sync" class="text-text-secondary hover:text-text-primary"
        >Sync</a
      >
      <a href="#pricing" class="text-text-secondary hover:text-text-primary"
        >Pricing</a
      >
      <a href="#download" class="text-text-secondary hover:text-text-primary"
        >Download</a
      >
    </nav>
  </div>
  <div class="mx-auto max-w-6xl px-6 pb-10">
    <p class="text-xs text-text-muted">© {year} Myelin</p>
  </div>
</footer>
