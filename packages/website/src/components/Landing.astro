---
// The home page, in one language. `src/pages/index.astro` renders this for
// English and `src/pages/[locale]/index.astro` for every other locale, so the
// two renderings and their structured data cannot drift apart.
import StaticSite from './static/StaticSite.astro';
import Base from '../layouts/Base.astro';
import { getCopy, getFaqs } from '../content/site';
import { siteLinks } from '../content/site/links';
import { type Locale, localeTags } from '../lib/locale';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const faqs = getFaqs(locale);
const languageTag = localeTags[locale];

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': new URL('#app', Astro.site).href,
  name: 'Myelin Notes',
  alternateName: 'Myelin',
  url: Astro.site?.href,
  sameAs: [siteLinks.source],
  downloadUrl: siteLinks.releases,
  publisher: { '@id': new URL('#organization', Astro.site).href },
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS, Windows, Linux',
  description: copy.meta.description,
  inLanguage: languageTag,
  offers: [
    { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
    {
      '@type': 'Offer',
      name: 'Myelin Pro',
      price: '49.99',
      priceCurrency: 'USD',
      url: new URL('/pricing', Astro.site).href,
    },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: languageTag,
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('#website', Astro.site).href,
  name: 'Myelin Notes',
  alternateName: 'Myelin',
  url: Astro.site?.href,
  publisher: { '@id': new URL('#organization', Astro.site).href },
};
---

<Base
  locale={locale}
  title={copy.meta.title}
  description={copy.meta.description}
  jsonLd={[websiteJsonLd, softwareJsonLd, faqJsonLd]}
>
  <StaticSite locale={locale} />
</Base>
