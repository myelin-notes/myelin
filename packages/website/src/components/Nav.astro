---
import { Wordmark, buttonVariants, cn } from '@myelin/ui';

const links = [
  { label: 'Workspace', href: '#workspace' },
  { label: 'Search', href: '#search' },
  { label: 'Sync', href: '#sync' },
];
---

<header class="sticky top-0 z-50 bg-page/95">
  <nav
    class="mx-auto flex h-20 max-w-6xl items-center justify-between px-6 lg:px-10"
    aria-label="Primary"
  >
    <a href="/" class="flex items-baseline gap-3" aria-label="Myelin Notes home">
      <Wordmark className="text-[1.35rem]" />
      <span class="kicker hidden text-text-muted sm:inline">
        One canvas for every note
      </span>
    </a>

    <div class="flex items-center gap-9">
      <div class="hidden items-center gap-9 md:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="kicker text-text-secondary transition-colors hover:text-text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <a href="#download" class={cn(buttonVariants(), 'h-9 rounded-xl px-4')}>
        Download
      </a>
    </div>
  </nav>
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <div class="h-px w-full bg-border-ghost"></div>
  </div>
</header>
