---
import { Wordmark } from '@myelin/ui';
import { buttonVariants, cn } from '@myelin/ui';

const links = [
  { label: 'Features', href: '#features' },
  { label: 'Sync', href: '#sync' },
  { label: 'Pricing', href: '#pricing' },
];
---

<header
  class="sticky top-0 z-50 border-b border-border-subtle bg-page/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-2" aria-label="Myelin home">
      <Wordmark />
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-text-secondary transition-colors hover:text-text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href="#download"
      class={cn(buttonVariants(), 'h-9 px-4 rounded-xl')}
    >
      Download
    </a>
  </nav>
</header>
