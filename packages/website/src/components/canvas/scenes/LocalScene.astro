---
// Region 04 visual: the note settles onto "your disk", version snapshots
// stack up behind it, and the export formats sit ready. Quiet, reassuring.
---

<div class="relative mx-auto w-full max-w-[420px]" aria-hidden="true">
  <!-- version-history snapshots behind the note -->
  <div class="relative h-[230px]">
    <div
      data-fx="local-snap"
      class="absolute top-0 left-3 w-[240px] -rotate-3 rounded-xl border border-border-divider bg-card/60 p-4"
    >
      <p class="kicker text-text-muted">Mon 9:41</p>
    </div>
    <div
      data-fx="local-snap"
      class="absolute top-3 left-10 w-[240px] rotate-2 rounded-xl border border-border-divider bg-card/80 p-4"
    >
      <p class="kicker text-text-muted">Tue 14:02</p>
    </div>
    <div
      data-fx="local-note"
      class="absolute top-8 left-16 w-[260px] rounded-xl bg-card p-5 shadow-elevated"
    >
      <p class="font-heading text-lg text-text-primary">Week 4 — diffusion</p>
      <div class="mt-3 space-y-2">
        <div class="h-1.5 w-full rounded-full bg-sidebar-bg"></div>
        <div class="h-1.5 w-4/5 rounded-full bg-sidebar-bg"></div>
        <div class="h-1.5 w-3/5 rounded-full bg-sidebar-bg"></div>
      </div>
      <svg viewBox="0 0 90 26" class="mt-3 h-5 w-[80px] text-accent-navy" fill="none">
        <path
          class="ink-stroke"
          stroke-width="2"
          d="M4 20 C 12 8 20 8 24 16 C 28 22 36 20 40 12 C 44 6 52 8 54 16 C 56 22 66 18 74 10 C 78 6 84 8 86 12"
        ></path>
      </svg>
    </div>
  </div>

  <!-- the disk -->
  <div
    data-fx="rise"
    class="relative z-10 mt-2 flex h-16 items-center justify-center gap-2.5 rounded-2xl border border-border-divider bg-surface"
  >
    <span class="size-1.5 rounded-full bg-accent-green"></span>
    <span class="kicker text-text-muted">Your disk</span>
  </div>

  <!-- export formats -->
  <div class="mt-5 flex flex-wrap justify-center gap-2">
    {['Markdown', 'PDF', 'Obsidian vault', 'Workspace file'].map((format) => (
      <span
        data-fx="local-chip"
        class="rounded-full border border-border-divider bg-card px-3 py-1 text-xs font-medium text-text-secondary"
      >
        {format}
      </span>
    ))}
  </div>
</div>
