---
interface Props {
  variant?: 0 | 1 | 2;
  class?: string;
}

const { variant = 0, class: className } = Astro.props;
const paths = [
  'M3 9C20 4 36 12 54 7S82 5 97 8',
  'M3 6C22 9 38 3 58 7S84 10 97 5',
  'M3 8C18 5 40 10 60 6S86 4 97 9',
];
---

<svg
  aria-hidden="true"
  viewBox="0 0 100 14"
  preserveAspectRatio="none"
  class:list={['ink-scroll block h-3 w-20 overflow-visible text-ink', className]}
>
  <path
    d={paths[variant]}
    fill="none"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"></path>
</svg>
