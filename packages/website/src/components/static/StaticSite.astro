---
// The no-canvas rendering of the site: every word the scrollytelling canvas
// says, as ordinary scrolling markup. Served to crawlers, no-JS visitors, and
// touch/narrow viewports. Sections follow the canvas scene order (see
// `src/canvas/scenes.ts`) so the two tell the same story in the same sequence.
//
// The gate in `Base.astro` hides this before first paint wherever the canvas
// will run, so desktop never renders a frame of it.
import Placeholder from './Placeholder.astro';
import { copy, faqs, siteLinks } from '../../content/site';

const section = 'mx-auto max-w-3xl px-6 py-16';
const heading =
  'font-heading text-3xl leading-tight font-medium tracking-tight whitespace-pre-line sm:text-4xl';
const body = 'mt-5 text-base leading-relaxed text-text-secondary';
const button =
  'inline-flex items-center rounded-xl bg-accent-dark px-5 py-2.5 text-sm font-medium text-text-on-dark';
const buttonOutline =
  'inline-flex items-center rounded-xl border border-border-divider px-5 py-2.5 text-sm font-medium text-text-primary';
---

<div class="static-site pt-12">
  <section class:list={[section, 'pt-16 pb-12']}>
    <h1 class={`${heading} text-4xl sm:text-5xl`}>{copy.hero.headline}</h1>
    <p class={`${body} text-lg`}>{copy.hero.subheadline}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={siteLinks.releases} class={button}>{copy.hero.ctaPrimary}</a>
      <a href="#download" class={buttonOutline}>{copy.hero.ctaSecondary}</a>
    </div>
    <p class="mt-6 text-sm text-text-muted">{copy.hero.trustLine}</p>
  </section>

  <section class={section}>
    <h2 class={heading}>{copy.ink.pdfHeading}</h2>
    <p class={body}>{copy.ink.pdfBody}</p>
    <Placeholder label="PDF with ink annotations" class="mt-8 h-72" />
  </section>

  <section class={section}>
    <h2 class={heading}>{copy.pages.heading}</h2>
    <p class={body}>{copy.pages.body}</p>
    <Placeholder label={copy.pages.pageTitle} class="mt-8 h-72" />
  </section>

  <section class={section}>
    <h2 class={heading}>{copy.audioSearch.heading}</h2>
    <p class={body}>{copy.audioSearch.audioBody}</p>
    <Placeholder label="Recording with on-device transcript" class="mt-8 h-40" />
    <p class={body}>{copy.audioSearch.searchBody}</p>
    <Placeholder label="Search across pages, ink, and audio" class="mt-8 h-40" />
  </section>

  <section class={section}>
    <h2 class={heading}>{copy.linked.heading}</h2>
    <p class={body}>{copy.linked.body}</p>
  </section>

  <section id="local" class={section}>
    <h2 class={heading}>{copy.localFirst.heading}</h2>
    <p class={body}>{copy.localFirst.lede}</p>
    <ul class="mt-8 space-y-4">
      {
        copy.localFirst.bullets.map((bullet) => (
          <li class="border-l-2 border-border-divider pl-4 text-text-secondary">
            {bullet}
          </li>
        ))
      }
    </ul>
  </section>

  <section id="sync" class={section}>
    <h2 class={heading}>{copy.sync.heading}</h2>
    <p class={body}>{copy.sync.kicker}</p>
    <div class="mt-8 space-y-6">
      {
        copy.sync.tiers.map((tier) => (
          <div class="rounded-2xl border border-border-divider bg-card p-6">
            <span class="rounded-full bg-tag px-2.5 py-1 text-xs font-medium text-text-tag">
              {tier.badge}
            </span>
            <h3 class="mt-4 font-heading text-xl font-medium">{tier.title}</h3>
            <p class="mt-2 text-text-secondary">{tier.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class={section}>
    <h2 class={heading}>{copy.supporter.heading}</h2>
    <p class={body}>{copy.supporter.body}</p>
    <ul class="mt-6 space-y-2 text-text-secondary">
      {copy.supporter.benefits.map((benefit) => <li>{benefit}</li>)}
    </ul>
    <p class="mt-6 text-sm text-text-muted">{copy.supporter.reassurance}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={siteLinks.sponsors} class={button}>
        {copy.supporter.ctaPrimary}
      </a>
      <a href={siteLinks.kofi} class={buttonOutline}>
        {copy.supporter.ctaSecondary}
      </a>
    </div>
  </section>

  <section id="download" class={section}>
    <h2 class={heading}>{copy.download.heading}</h2>
    <p class={body}>{copy.download.body}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      {
        copy.download.platforms.map((platform) => (
          <a href={siteLinks.releases} class={button}>
            {platform.label}
            <span class="ml-2 opacity-60">{platform.sub}</span>
          </a>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-text-muted">{copy.download.ipadBadge}</p>
  </section>

  <section id="faq" class={section}>
    <h2 class={heading}>{copy.download.faqTitle}</h2>
    <dl class="mt-8 space-y-6">
      {
        faqs.map((faq) => (
          <div>
            <dt class="font-medium text-text-primary">{faq.question}</dt>
            <dd class="mt-2 text-text-secondary">{faq.answer}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <footer class="border-t border-border-divider">
    <div class:list={[section, 'py-12']}>
      <p class="font-heading text-lg">{copy.footer.tagline}</p>
      <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          copy.footer.links.map((link) => (
            <li>
              <a href={link.href} class="text-text-secondary underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-text-muted">{copy.footer.privacyNote}</p>
    </div>
  </footer>
</div>
