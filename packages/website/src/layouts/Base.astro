---
import Seo from '../components/Seo.astro';
import SiteTopbar from '../components/SiteTopbar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Myelin Notes is a native, local-first canvas where handwriting, type, PDFs, images, and audio live in one note, kept on your own machine. Free while it is in early access.',
  image,
  jsonLd,
} = Astro.props;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Myelin Notes',
  url: Astro.site?.href,
};
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/caveat-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <Seo
      title={title}
      description={description}
      image={image}
      jsonLd={[organization, ...pageJsonLd]}
    />
    <script>
      import { initWebAnalytics } from '../lib/posthog';

      // Hold analytics until the main thread is free, so PostHog neither
      // downloads nor executes while the canvas bundle is still landing. The
      // timeout is the backstop for a page that never goes idle.
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => void initWebAnalytics(), { timeout: 5000 });
      } else {
        setTimeout(() => void initWebAnalytics(), 2000);
      }
    </script>
  </head>
  <body>
    <SiteTopbar />
    <slot />
  </body>
</html>
