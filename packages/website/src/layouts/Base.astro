---
import Seo from '../components/Seo.astro';
import SiteTopbar from '../components/SiteTopbar.astro';
import { getCopy } from '../content/site';
import { type Locale, localeTags } from '../lib/locale';
import '../styles/global.css';

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** False on pages published in one language only (the privacy policy). */
  translated?: boolean;
}

const {
  title,
  locale,
  description = getCopy(locale).meta.description,
  image,
  jsonLd,
  translated = true,
} = Astro.props;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('#organization', Astro.site).href,
  name: 'Myelin Notes',
  url: Astro.site?.href,
  sameAs: ['https://github.com/myelin-notes'],
};
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={localeTags[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <title>{title}</title>
    <Seo
      title={title}
      description={description}
      image={image}
      translated={translated}
      jsonLd={[organization, ...pageJsonLd]}
    />
    <script>
      import { detectPlatform } from '../lib/downloads';
      import { initWebAnalytics, trackWebEvent } from '../lib/posthog';

      // Hold analytics until the main thread is free, so PostHog neither
      // downloads nor executes while the canvas bundle is still landing. The
      // timeout is the backstop for a page that never goes idle.
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => void initWebAnalytics(), { timeout: 5000 });
      } else {
        setTimeout(() => void initWebAnalytics(), 2000);
      }

      // Capture phase, so a handler that stops propagation cannot hide a click.
      document.addEventListener(
        'click',
        (event) => {
          const link = (event.target as Element).closest<HTMLAnchorElement>(
            'a[data-download]',
          );
          if (!link) {
            return;
          }
          const platform = link.dataset.download;
          trackWebEvent('download_clicked', {
            platform: platform === 'auto' ? detectPlatform() : platform,
          });
        },
        true,
      );
    </script>
  </head>
  <body>
    <SiteTopbar locale={locale} translated={translated} />
    <slot />
  </body>
</html>
