---
// The pricing page for every locale other than the default, which lives
// unprefixed at `src/pages/pricing.astro`.
import Pricing from '../../components/Pricing.astro';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../../lib/locale';

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map(
    (locale) => ({ params: { locale } }),
  );
}

const { locale } = Astro.params as { locale: Locale };
---

<Pricing locale={locale} />
