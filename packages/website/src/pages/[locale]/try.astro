---
// The try-it page for every locale other than the default, which lives
// unprefixed at `src/pages/try.astro`.
import TryIt from '../../components/TryIt.astro';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../../lib/locale';

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map(
    (locale) => ({ params: { locale } }),
  );
}

const { locale } = Astro.params as { locale: Locale };
---

<TryIt locale={locale} />
