---
import Base from '../layouts/Base.astro';

const input =
  'mt-1.5 w-full rounded-xl border border-border-divider bg-card px-4 py-2.5 text-text-primary outline-none transition-colors placeholder:text-text-muted focus:border-primary';
---

<Base
  locale="en"
  translated={false}
  title="Admin | Myelin Notes"
  description="Grant Myelin Notes Pro."
>
  <main class="mx-auto max-w-3xl px-6 pt-12 pb-12 lg:px-10">
    <header class="pt-8 pb-8">
      <p class="kicker text-text-muted">Admin</p>
      <h1
        class="mt-3 font-heading text-[clamp(2.2rem,4.5vw,3.4rem)] leading-[1.05] font-medium tracking-[-0.02em] text-text-primary"
      >
        Grant Pro
      </h1>
    </header>

    <div class="h-px w-full bg-border-ghost"></div>

    <form id="grant-form" action="/api/admin-grant" class="pt-8">
      <div>
        <label for="email" class="text-sm font-medium text-text-primary">
          Customer email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          maxlength="254"
          required
          class={input}
          placeholder="them@example.com"
        />
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-5">
        <button
          type="submit"
          class="inline-flex h-11 items-center justify-center rounded-2xl bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:brightness-110 disabled:pointer-events-none disabled:opacity-50"
        >
          Grant Pro
        </button>
        <p
          id="grant-status"
          class="text-sm break-all text-text-secondary select-all"
          role="status"
          aria-live="polite"
        >
        </p>
      </div>
    </form>
  </main>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#grant-form');
  const status = document.querySelector<HTMLElement>('#grant-status');
  const submitButton = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !status || !submitButton) {
      return;
    }
    const data = new FormData(form);

    submitButton.disabled = true;
    status.textContent = 'Granting…';
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: JSON.stringify({ email: data.get('email') }),
      });
      const body = (await response.json().catch(() => ({}))) as {
        key?: string;
        message?: string;
      };
      status.textContent = body.key
        ? `Granted. License key: ${body.key}`
        : (body.message ?? `Failed (${response.status}).`);
    } catch {
      status.textContent = 'Could not reach the server.';
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
