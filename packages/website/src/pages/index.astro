---
import CanvasIsland from '../canvas/CanvasIsland';
import Base from '../layouts/Base.astro';
import { siteDescription, siteTitle } from '../content/site';

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Myelin Notes',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS, Windows, Linux, iPadOS, Android',
  description: siteDescription,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<Base title={siteTitle} description={siteDescription} jsonLd={[softwareJsonLd]}>
  <!-- The live editor: the real Myelin canvas engine, full screen, with the
       app's tool rail. Client-only so React Fast Refresh works in dev. -->
  <CanvasIsland client:only="react" />
</Base>
