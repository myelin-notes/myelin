---
import Base from '../layouts/Base.astro';
import CanvasIsland from '../canvas/CanvasIsland';
import { regions, siteDescription, siteTitle } from '../content/site';

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Myelin Notes',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS, Windows, Linux, iPadOS, Android',
  description: siteDescription,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

// Scroll length of the camera tour: one generous viewport-height segment per
// region keeps the pacing calm.
const trackHeight = `${regions.length * 130}vh`;
---

<Base title={siteTitle} description={siteDescription} jsonLd={[softwareJsonLd]}>
  <!-- Scrollbar for the canvas camera; only shown once the notebook is live. -->
  <div class="canvas-track" style={`height: ${trackHeight}`} aria-hidden="true">
  </div>

  <!--
    The live notebook. Loads only on desktop pointers (see CanvasIsland). There
    is no static/mobile fallback right now; a standalone version will be built
    separately.
  -->
  <CanvasIsland client:only="react" />
</Base>
