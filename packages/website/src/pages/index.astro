---
import { buttonVariants, cn } from '@myelin/ui';
import Base from '../layouts/Base.astro';
import NeuralField from '../components/NeuralField.tsx';

const cta = cn(buttonVariants(), 'h-11 rounded-2xl px-6 text-sm');

const features = [
  {
    index: '01',
    title: 'Write together, live',
    body: 'Invite people into a note and edit the same page at the same time. Changes land as they happen, with no merge conflicts to settle afterward.',
  },
  {
    index: '02',
    title: 'Find anything you have written',
    body: 'Handwriting, PDFs, and images become searchable text. Reach any idea you have filed away in a single keystroke.',
  },
  {
    index: '03',
    title: 'Sync through your own GitHub',
    body: 'Your library lives in a Git repository you control. Portable, durable, and yours. No account needed to begin.',
  },
  {
    index: '04',
    title: 'Built like a studio, not a database',
    body: 'A serif for reading, a sans for the controls, tonal surfaces, and room to think. The workspace stays out of the way while you work.',
  },
];

const tiers = [
  {
    name: 'Free',
    price: '$0',
    cadence: '/ forever',
    blurb:
      'The whole editor. For anyone trying Myelin or keeping notes on their own machine.',
    items: [
      'Unlimited local notes',
      'Hybrid canvas, typed + ink',
      'PDF, image, and Markdown import and export',
      'Sync through your own GitHub',
      'Co-edit live through a shared GitHub repo',
      'Local-first, offline-always',
      'Local search over titles, tags, and indexed local content once search ships',
    ],
    cta: 'Download Myelin',
    emphasized: false,
  },
  {
    name: 'Pro',
    price: '$8',
    cadence: '/ month · $72 / year',
    blurb:
      'For students, researchers, and writers who live in their notes — on their own or together.',
    items: [
      'Everything in Free',
      'Managed collaboration — invite people to a note by link, no GitHub needed',
      'Full-content search across notes, PDFs, and handwriting',
      'Semantic search — find notes by idea, not exact wording',
      'OCR — reading text out of handwriting and scanned PDFs, on all platforms',
      'Persistent version history and restore',
      'Managed Myelin Cloud sync and backup',
      'Priority support and early access',
    ],
    cta: 'Start 14-day trial',
    emphasized: true,
    flag: 'Most chosen',
  },
];

const platforms = ['macOS', 'Windows', 'Linux', 'iPadOS', 'Android'];
---

<Base title="Myelin — one workspace, every device">
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 lg:px-10">
    <div
      class="grid items-center gap-y-20 pt-16 pb-24 lg:grid-cols-12 lg:gap-x-10 lg:pt-24 lg:pb-32"
    >
      <div class="lg:col-span-7">
        <p
          class="kicker rise text-text-muted"
          style="animation-delay:.05s"
        >
          A native knowledge workspace
        </p>
        <h1
          class="rise mt-6 font-heading text-[clamp(2.9rem,6.4vw,5.25rem)] leading-[0.98] font-medium tracking-[-0.02em] text-text-primary"
          style="animation-delay:.12s"
        >
          The workspace that keeps every device in <em
            class="font-normal text-accent-navy italic">lockstep</em
          >
        </h1>
        <p
          class="rise mt-7 max-w-xl text-lg leading-relaxed text-text-secondary"
          style="animation-delay:.2s"
        >
          Open a note on your laptop and your iPad at once. Sketch with the
          pencil while you type, and watch both halves grow together. No save
          step, no reconciliation. Myelin is native on every platform and syncs
          through a GitHub repository you own.
        </p>
        <div
          class="rise mt-10 flex flex-wrap items-center gap-x-7 gap-y-4"
          style="animation-delay:.28s"
        >
          <a href="#download" class={cta}>Download Myelin</a>
          <a
            href="#sync"
            class="group inline-flex items-center gap-2 text-sm font-medium text-text-primary"
          >
            See how sync works
            <span
              class="transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true">→</span
            >
          </a>
        </div>
      </div>

      <div class="rise lg:col-span-5" style="animation-delay:.36s">
        <div class="relative mx-auto aspect-square w-full max-w-md">
          <NeuralField client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- Manifesto -->
  <section class="bg-surface">
    <div class="mx-auto max-w-6xl px-6 py-24 lg:px-10 lg:py-32">
      <p class="kicker text-text-muted">The idea</p>
      <blockquote
        class="mt-6 max-w-4xl font-heading text-[clamp(1.9rem,4vw,3.25rem)] leading-[1.12] font-normal text-text-primary"
      >
        Every device is a different lens onto the same workspace.
      </blockquote>
      <p class="mt-8 max-w-md text-text-secondary">
        Desktop for deep work. Tablet for sketching. Phone for capture. One
        library underneath, always current.
      </p>
    </div>
  </section>

  <!-- Features -->
  <section id="workspace" class="mx-auto max-w-6xl px-6 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-x-10 gap-y-6 lg:grid-cols-12">
      <p class="kicker text-text-muted lg:col-span-3">02 / What it does</p>
      <h2
        class="font-heading text-[clamp(1.9rem,3.6vw,3rem)] leading-tight font-medium tracking-[-0.01em] text-text-primary lg:col-span-9"
      >
        Built for the way you actually work
      </h2>
    </div>

    <ul class="mt-16 lg:mt-20">
      {
        features.map((feature) => (
          <li class="grid gap-x-10 gap-y-3 py-9 lg:grid-cols-12">
            <span
              class="font-heading text-3xl font-normal text-text-muted/45 lg:col-span-2"
              aria-hidden="true"
            >
              {feature.index}
            </span>
            <h3 class="text-xl font-semibold text-text-primary lg:col-span-4">
              {feature.title}
            </h3>
            <p class="max-w-md text-text-secondary lg:col-span-6">
              {feature.body}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Sync -->
  <section id="sync" class="bg-surface">
    <div
      class="mx-auto grid max-w-6xl gap-x-10 gap-y-14 px-6 py-24 lg:grid-cols-12 lg:px-10 lg:py-32"
    >
      <div class="lg:col-span-5">
        <p class="kicker text-text-muted">03 / Sync</p>
        <h2
          class="mt-6 font-heading text-[clamp(1.9rem,3.6vw,3rem)] leading-tight font-medium tracking-[-0.01em] text-text-primary"
        >
          Your library, your repository
        </h2>
        <p class="mt-7 text-text-secondary">
          On the free plan, Myelin syncs through a GitHub repository you own. It
          is plain, portable data you can read, back up, and move whenever you
          like.
        </p>
        <p class="mt-4 text-text-secondary">
          To bring other people in without handing out repository access, Pro
          adds managed Myelin Cloud sync and invite links, so a single link is
          all it takes.
        </p>
      </div>

      <div class="lg:col-span-7 lg:pl-10">
        <div class="rounded-3xl bg-card p-8 shadow-elevated lg:p-10">
          <div class="flex items-center justify-between gap-6">
            <div>
              <p class="kicker text-text-muted">Laptop</p>
              <p class="mt-2 font-heading text-lg text-text-primary">
                editing the paragraph
              </p>
            </div>
            <span
              class="inline-flex items-center gap-2 rounded-full bg-bg-success-soft px-3 py-1.5 text-xs font-medium text-text-green"
            >
              <span class="size-1.5 rounded-full bg-accent-green"></span>
              live
            </span>
          </div>

          <div class="my-7 flex items-center gap-4">
            <span class="h-px flex-1 bg-border-divider"></span>
            <span class="kicker text-text-muted">same note</span>
            <span class="h-px flex-1 bg-border-divider"></span>
          </div>

          <div class="flex items-center justify-between gap-6">
            <div>
              <p class="kicker text-text-muted">iPad</p>
              <p class="mt-2 font-heading text-lg text-text-primary">
                sketching the diagram
              </p>
            </div>
            <span
              class="inline-flex items-center gap-2 rounded-full bg-bg-success-soft px-3 py-1.5 text-xs font-medium text-text-green"
            >
              <span class="size-1.5 rounded-full bg-accent-green"></span>
              live
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="mx-auto max-w-6xl px-6 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-x-10 gap-y-6 lg:grid-cols-12">
      <p class="kicker text-text-muted lg:col-span-3">04 / Pricing</p>
      <h2
        class="font-heading text-[clamp(1.9rem,3.6vw,3rem)] leading-tight font-medium tracking-[-0.01em] text-text-primary lg:col-span-9"
      >
        Free to think alone. Pro to think together
      </h2>
    </div>

    <div class="mt-16 grid gap-6 md:mx-auto md:max-w-3xl lg:mt-20 lg:grid-cols-2">
      {
        tiers.map((tier) => (
          <div
            class={cn(
              'relative flex flex-col gap-5 rounded-[16px] p-8 shadow-ambient transition duration-500 ease-out hover:-translate-y-1 hover:shadow-elevated',
              tier.emphasized
                ? 'bg-primary text-text-on-dark lg:scale-[1.03]'
                : 'bg-card text-text-primary',
            )}
          >
            {tier.flag && (
              <span class="absolute top-5 right-5 rounded-[10px] bg-accent-green px-2.5 py-1 text-[10px] font-bold tracking-[0.14em] text-text-green uppercase">
                {tier.flag}
              </span>
            )}
            <div>
              <h3 class="font-heading text-2xl font-medium tracking-tight">
                {tier.name}
              </h3>
              <p
                class={cn(
                  'mt-1.5 max-w-[34ch] text-[13px] leading-relaxed',
                  tier.emphasized ? 'text-[#cbd2dc]' : 'text-text-muted',
                )}
              >
                {tier.blurb}
              </p>
            </div>
            <div class="flex items-baseline gap-1.5">
              <span class="font-heading text-[44px] leading-none font-light tracking-tight">
                {tier.price}
              </span>
              <span
                class={cn(
                  'text-[13px]',
                  tier.emphasized ? 'text-[#aab3c1]' : 'text-text-muted',
                )}
              >
                {tier.cadence}
              </span>
            </div>

            <ul
              class={cn(
                'grid gap-2.5 text-sm',
                tier.emphasized ? 'text-[#d6dce5]' : 'text-text-secondary',
              )}
            >
              {tier.items.map((item) => (
                <li class="grid grid-cols-[18px_1fr] gap-2.5">
                  <svg
                    class="mt-1 size-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="m5 12 5 5 9-11"
                      stroke={tier.emphasized ? 'var(--bg-accent-green)' : 'var(--text-green)'}
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <a
              href="#download"
              class={cn(
                'mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-medium',
                tier.emphasized ? 'text-text-on-dark' : 'text-text-primary',
              )}
            >
              {tier.cta}
              <span class={tier.emphasized ? 'text-accent-green' : 'text-text-green'}>
                →
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Download -->
  <section id="download" class="bg-primary text-text-on-dark">
    <div class="mx-auto max-w-6xl px-6 py-28 lg:px-10 lg:py-36">
      <p class="kicker text-text-on-dark/55">Start where you are</p>
      <h2
        class="mt-6 max-w-3xl font-heading text-[clamp(2.2rem,4.5vw,4rem)] leading-[1.04] font-medium tracking-[-0.015em]"
      >
        Bring Myelin to your desk, and pick up where you left off on every other
        screen
      </h2>
      <div class="mt-12 flex flex-wrap gap-3">
        {
          platforms.map((platform) => (
            <a
              href="#"
              class="rounded-xl bg-white/10 px-5 py-2.5 text-sm font-medium text-text-on-dark transition-colors hover:bg-white/20"
            >
              {platform}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
