---
import Base from '../layouts/Base.astro';

const input =
  'mt-2 w-full rounded-xl border border-border-divider bg-card px-4 py-3 text-text-primary outline-none transition-colors placeholder:text-text-muted focus:border-primary';
---

<Base
  locale="en"
  translated={false}
  title="Support | Myelin Notes"
  description="Contact Myelin Notes support."
>
  <main class="mx-auto max-w-3xl px-6 pt-12 pb-24 lg:px-10">
    <header class="pt-16 pb-12">
      <p class="kicker text-text-muted">Support</p>
      <h1
        class="mt-6 font-heading text-[clamp(2.2rem,4.5vw,3.4rem)] leading-[1.05] font-medium tracking-[-0.02em] text-text-primary"
      >
        How can we help?
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-text-secondary">
        Send a note to Myelin Support. Your message goes directly to
        admin@trymyelin.app, and we’ll reply to the email address you provide.
      </p>
    </header>

    <div class="h-px w-full bg-border-ghost"></div>

    <form
      id="support-form"
      action="/api/support"
      method="post"
      class="pt-12"
    >
      <div>
        <label for="email" class="text-sm font-medium text-text-primary">
          Email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
          class={input}
          placeholder="you@example.com"
        />
      </div>

      <div class="mt-7">
        <label for="subject" class="text-sm font-medium text-text-primary">
          Subject
        </label>
        <input
          id="subject"
          name="subject"
          type="text"
          maxlength="160"
          required
          class={input}
          placeholder="What do you need help with?"
        />
      </div>

      <div class="mt-7">
        <label for="message" class="text-sm font-medium text-text-primary">
          Message
        </label>
        <textarea
          id="message"
          name="message"
          rows="8"
          maxlength="5000"
          required
          class={`${input} resize-y`}
          placeholder="Tell us what happened and what you expected."
        ></textarea>
      </div>

      <div class="absolute -left-[10000px]" aria-hidden="true">
        <label for="company">Company</label>
        <input
          id="company"
          name="company"
          type="text"
          autocomplete="off"
          tabindex="-1"
        />
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-5">
        <button
          type="submit"
          class="inline-flex h-11 items-center justify-center rounded-2xl bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:brightness-110 disabled:pointer-events-none disabled:opacity-50"
        >
          Send message
        </button>
        <p
          id="support-status"
          class="text-sm text-text-secondary"
          role="status"
          aria-live="polite"
        ></p>
      </div>

      <p class="mt-7 text-sm leading-relaxed text-text-muted">
        The details you submit are used only to respond to your request. See our{' '}
        <a
          href="/privacy"
          class="underline underline-offset-4 hover:text-text-primary">privacy policy</a
        >.
      </p>
    </form>
  </main>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#support-form');
  const status = document.querySelector<HTMLElement>('#support-status');
  const submitButton = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !status || !submitButton) {
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
    status.textContent = '';

    let errorMessage = 'We could not send your message. Please try again.';
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const body = (await response.json().catch(() => ({}))) as {
        message?: string;
      };

      if (!response.ok) {
        errorMessage = body.message ?? errorMessage;
        throw new Error();
      }

      form.reset();
      status.textContent = body.message ?? 'Thanks. Your message has been sent.';
    } catch {
      status.textContent = errorMessage;
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send message';
    }
  });
</script>
