---
import Base from '../layouts/Base.astro';

const elementTypes = [
  { value: 0, name: 'STROKE', desc: 'A pen or highlighter stroke' },
  { value: 1, name: 'TEXT', desc: 'A free-floating text box' },
  { value: 2, name: 'IMAGE', desc: 'An embedded image' },
  { value: 3, name: 'PAGE_FRAME', desc: 'A rich-text page (its text lives in content)' },
  { value: 4, name: 'PDF', desc: 'An embedded PDF' },
  { value: 5, name: 'SHAPE', desc: 'A vector shape' },
  { value: 6, name: 'LATEX', desc: 'A rendered LaTeX expression' },
  { value: 7, name: 'AUDIO', desc: 'An embedded audio clip' },
];

const noteFields = [
  { name: 'version', type: 'number', desc: 'Schema version stamped on every note. Currently 1. Import rejects a file whose version it does not recognize.' },
  { name: 'name', type: 'string', desc: 'The note’s display name.' },
  { name: 'fileType', type: 'string', desc: 'The note’s file type. Canvas notes are "mcanvas".' },
  { name: 'tags', type: 'string[]', desc: 'Tags applied to the note.' },
  { name: 'createdAt', type: 'number', desc: 'Creation time, milliseconds since the Unix epoch.' },
  { name: 'modifiedAt', type: 'number', desc: 'Last-modified time, milliseconds since the Unix epoch.' },
  { name: 'elements', type: 'object[]', desc: 'Every element on the canvas, in document order. See below.' },
];

const exampleNote = `{
  "version": 1,
  "name": "Sample",
  "fileType": "mcanvas",
  "tags": ["a", "b"],
  "createdAt": 1750636800000,
  "modifiedAt": 1750636900000,
  "elements": [
    {
      "type": 3,
      "uuid": "page-frame-1",
      "offsetX": 0,
      "offsetY": 0,
      "scaleX": 1,
      "scaleY": 1,
      "displayName": "Page",
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": { "level": 1 },
            "content": [{ "type": "text", "text": "Title" }]
          },
          {
            "type": "paragraph",
            "content": [
              { "type": "text", "text": "Hello " },
              {
                "type": "text",
                "marks": [{ "type": "strong" }],
                "text": "world"
              }
            ]
          }
        ]
      }
    },
    {
      "type": 0,
      "uuid": "stroke-1",
      "offsetX": 5,
      "offsetY": 6,
      "scaleX": 1,
      "scaleY": 1,
      "color": "#ff0000",
      "size": 4,
      "hasPressure": false,
      "points": [0, 0, 0.5, 10, 12, 0.7]
    },
    {
      "type": 2,
      "uuid": "image-1",
      "offsetX": 20,
      "offsetY": 30,
      "scaleX": 1,
      "scaleY": 1,
      "naturalWidth": 2,
      "naturalHeight": 3,
      "imageData": { "__bytes__": "AAECyP7/" }
    }
  ]
}`;

const exampleTree = `My Workspace/
├─ Research/
│  ├─ Reading notes.json
│  └─ diagram.png
├─ Inbox/
│  └─ Scratch.json
└─ Welcome.json`;
---

<Base
  title="Workspace export schema — Myelin Notes"
  description="The JSON schema Myelin Notes uses when you export a workspace: the on-disk layout, the note format, and how canvas elements and binary data are encoded."
>
  <section>
    <p>Reference</p>
    <h1>Workspace export schema</h1>
    <p>
      When you export a workspace, Myelin Notes writes a plain folder of files you
      own and can read. Canvas notes become JSON, and any standalone media is
      copied alongside them. This page documents that JSON so you can read,
      diff, or generate it yourself.
    </p>

    <!-- On-disk layout -->
    <section>
      <h2>On-disk layout</h2>
      <p>
        An export is a single root folder that mirrors your workspace
        hierarchy. Each canvas note is written as a <code>.json</code>
        file; standalone media (images, PDFs, audio) is copied as-is into the
        same folders.
      </p>
      <pre>{exampleTree}</pre>
    </section>

    <!-- Note file -->
    <section>
      <h2>The note file</h2>
      <p>
        Every canvas note is one JSON object with these top-level fields.
      </p>
      <table>
        <thead>
          <tr>
            <th>Field</th>
            <th>Type</th>
            <th>Meaning</th>
          </tr>
        </thead>
        <tbody>
          {
            noteFields.map((field) => (
              <tr>
                <td>{field.name}</td>
                <td>{field.type}</td>
                <td>{field.desc}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <!-- Elements -->
    <section>
      <h2>Elements</h2>
      <p>
        Each entry in <code>elements</code>
        is a flat object describing one thing on the canvas. Two fields
        identify every element:
      </p>
      <ul>
        <li>
          <code>type</code>
          — a number from the element-type table below.
        </li>
        <li>
          <code>uuid</code>
          — a string that uniquely identifies the element within the note.
        </li>
      </ul>
      <p>
        Every other field is an element property. The set of properties
        depends on the element type — a stroke carries
        <code>color</code>,
        <code>size</code>
        and a flat
        <code>points</code>
        array of
        <code>[x, y, pressure]</code>
        triplets — read three numbers at a time, so
        <code>[0, 0, 0.5, 10, 12, 0.7]</code>
        is two points. The
        <code>hasPressure</code>
        flag says whether those pressure values came from a real stylus or were
        synthesized; the triplet stride is the same either way. An image carries
        its natural dimensions and pixel data.
        Most drawable elements also carry position
        (<code>offsetX</code>,
        <code>offsetY</code>)
        and scale
        (<code>scaleX</code>,
        <code>scaleY</code>).
        Properties not in the list below are preserved verbatim on import.
      </p>

      <h3>Element types</h3>
      <table>
        <thead>
          <tr>
            <th>type</th>
            <th>Name</th>
            <th>Meaning</th>
          </tr>
        </thead>
        <tbody>
          {
            elementTypes.map((el) => (
              <tr>
                <td>{el.value}</td>
                <td>{el.name}</td>
                <td>{el.desc}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h3>Page-frame text</h3>
      <p>
        A page frame (<code>type: 3</code>)
        holds its rich text in a reserved
        <code>content</code>
        field, separate from its other properties. The value is a
        <a
          href="https://prosemirror.net/docs/ref/#model.Node.toJSON"
          target="_blank"
          rel="noopener">ProseMirror document</a
        > serialized to JSON — a tree of
        <code>doc</code>,
        <code>heading</code>,
        <code>paragraph</code>,
        <code>text</code>
        nodes and marks. Only page frames use this field.
      </p>

      <h3>Binary data</h3>
      <p>
        Binary properties — such as an image’s pixel bytes — are wrapped
        in an object with a single
        <code>__bytes__</code>
        key whose value is the base64-encoded content. The wrapper lets the
        importer tell binaries apart from ordinary strings without knowing
        which fields are binary.
      </p>
      <pre>{`"imageData": { "__bytes__": "AAECyP7/" }`}</pre>
    </section>

    <!-- Example -->
    <section>
      <h2>A complete note</h2>
      <p>
        A note with one page frame, one stroke, and one image:
      </p>
      <pre>{exampleNote}</pre>
    </section>

    <!-- Versioning -->
    <section>
      <h2>Versioning</h2>
      <p>
        The current schema version is <strong>1</strong>.
        Every exported note carries it in the
        <code>version</code>
        field, and import refuses a file whose version it does not recognize.
        Timestamps live inside the JSON; reimporting a note creates a new file
        rather than restoring its original creation date.
      </p>
    </section>
  </section>
</Base>
