{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myelin",
  "version": "0.1.0",
  "identifier": "com.github.wintersteve25.myelin",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Myelin",
        "width": 1100,
        "height": 700,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": ["default", "updater"],
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: blob: data: https: http://asset.localhost; media-src 'self' asset: blob: https: http://asset.localhost; frame-src 'self' https:; connect-src 'self' ipc: http://ipc.localhost ws: wss: stun: turn: turns:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NUUwOTk0NzhCOEY3RjMKUldUejk3aDRsQWxleUNib3BueFREUVBsTkMvekJoeGxsNDlhR0k1RElNd0Z2bTdTeE5zWmQ0a0oK",
      "endpoints": [
        "https://updates.myelin.app/stable/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/embedding-models/": "embedding-models/",
      "resources/scribble-models/": "scribble-models/",
      "resources/LICENSES/": "LICENSES/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
